#!/bin/sh
set -e

VP_USER=viewpie

case "$1" in
configure)
    # A system user rather than a login account: the wall needs the video and
    # render groups for DRM and V4L2, and nothing else.
    if ! getent passwd "$VP_USER" >/dev/null; then
        adduser --system --group --no-create-home \
                --home /nonexistent --shell /usr/sbin/nologin \
                --gecos "Viewpie camera wall" "$VP_USER"
    fi
    # The service unit uses viewpie as its primary group too. Repair an
    # account created by an older/manual install that lacks that group.
    if ! getent group "$VP_USER" >/dev/null; then
        addgroup --system "$VP_USER"
    fi
    usermod --gid "$VP_USER" "$VP_USER"
    for grp in video render; do
        if getent group "$grp" >/dev/null; then
            adduser "$VP_USER" "$grp" >/dev/null 2>&1 || true
        fi
    done

    # RTSP urls embed credentials, so the configuration is private and is not
    # a conffile: an upgrade must never prompt about it or overwrite it.
    # Private is the file, not the directory, which anyone may list so that
    # a shell can complete the file's name for them. Set again on every
    # upgrade, which is what opens up the 0750 earlier versions made it.
    install -d -m 0755 -o "$VP_USER" -g "$VP_USER" /etc/viewpie

    # Keep the reboot credential across upgrades. Older experimental installs
    # Never create a secret in a build/container image; this is only for a real
    # systemd-managed Raspberry Pi installation.
    if [ -d /run/systemd/system ] && [ ! -e /.dockerenv ] &&
       [ ! -e /run/.containerenv ] && [ ! -e /run/systemd/container ]; then
    # used viewpie.env; migrate that value without ever printing it.
    VP_RESTART_ENV=/etc/viewpie/restart.env
    VP_OLD_RESTART_ENV=/etc/viewpie/viewpie.env
    if [ -L "$VP_RESTART_ENV" ]; then
        echo "viewpie: refusing symlink restart environment at $VP_RESTART_ENV" >&2
        exit 1
    fi
    if [ ! -s "$VP_RESTART_ENV" ]; then
        if [ -f "$VP_OLD_RESTART_ENV" ] &&
           grep -q '^VIEWPIE_RESTART_TOKEN=.' "$VP_OLD_RESTART_ENV"; then
            sed -n '/^VIEWPIE_RESTART_TOKEN=./p' "$VP_OLD_RESTART_ENV" |
                install -m 0600 -o root -g root /dev/stdin "$VP_RESTART_ENV"
        else
            VP_RESTART_TOKEN=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
            if [ "${#VP_RESTART_TOKEN}" -ne 64 ]; then
                echo "viewpie: could not generate restart token" >&2
                exit 1
            fi
            printf 'VIEWPIE_RESTART_TOKEN=%s\n' "$VP_RESTART_TOKEN" |
                install -m 0600 -o root -g root /dev/stdin "$VP_RESTART_ENV"
            echo "Viewpie restart token (enter once in the Home Assistant integration):"
            echo "$VP_RESTART_TOKEN"
            unset VP_RESTART_TOKEN
        fi
    fi
    chown root:root "$VP_RESTART_ENV"
    chmod 0600 "$VP_RESTART_ENV"
    fi
    VP_CONFIG=/etc/viewpie/viewpie.yaml
    # Never follow a config symlink when repairing ownership: doing so
    # could change permissions on a file outside /etc/viewpie.
    if [ -L "$VP_CONFIG" ]; then
        echo "viewpie: refusing symlink configuration at $VP_CONFIG" >&2
        exit 1
    fi
    if [ ! -e "$VP_CONFIG" ]; then
        install -m 0600 -o "$VP_USER" -g "$VP_USER" \
            /usr/share/viewpie/viewpie.yaml "$VP_CONFIG"
    else
        # API writes use an atomic rename by the viewpie service account.
        # Repair older root-owned or overly-permissive configs only after a
        # root-only backup, and never replace the user's YAML contents.
        VP_CONFIG_META=$(stat -c '%U:%G:%a' "$VP_CONFIG")
        if [ "$VP_CONFIG_META" != "$VP_USER:$VP_USER:600" ]; then
            VP_BACKUP_DIR=/var/backups/viewpie
            install -d -m 0700 -o root -g root "$VP_BACKUP_DIR"
            VP_BACKUP="$VP_BACKUP_DIR/viewpie.yaml.$(date +%Y%m%d%H%M%S)"
            VP_SUFFIX=0
            while [ -e "$VP_BACKUP" ]; do
                VP_SUFFIX=$((VP_SUFFIX + 1))
                VP_BACKUP="$VP_BACKUP_DIR/viewpie.yaml.$(date +%Y%m%d%H%M%S).$VP_SUFFIX"
            done
            cp -a -- "$VP_CONFIG" "$VP_BACKUP"
            chown "$VP_USER:$VP_USER" "$VP_CONFIG"
            chmod 0600 "$VP_CONFIG"
        fi
    fi

    # debhelper enables and starts the service below, as Debian expects of a
    # package shipping a daemon. The shipped configuration is all comments,
    # so it stops again immediately saying no wall is configured, which
    # leaves describing one as the only step. Said on a first install only
    # ("$2" is the version being upgraded from, and is empty otherwise).
    if [ -z "$2" ]; then
        echo "Describe your wall in /etc/viewpie/viewpie.yaml, then:"
        echo "  systemctl restart viewpie"
    fi
    ;;
esac

#DEBHELPER#

exit 0
